{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "regions": ["dub1"],
  "functions": {
    "src/app/api/cron/ingest-news/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/tick/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/refresh-klines-daily/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/cron/generate-briefing/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/ingest-etf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/ingest-macro/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/ingest-btc-treasuries/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/ingest-unlocks/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/cron/compute-impact/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/public/refresh-macro/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/public/refresh-treasuries/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/public/refresh-unlocks/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/data/**/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/agent/**/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest-news",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/refresh-klines-daily",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/equity-snapshots",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/generate-briefing",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/ingest-unlocks",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ingest-etf",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/ingest-macro",
      "schedule": "10 11 * * *"
    },
    {
      "path": "/api/cron/ingest-btc-treasuries",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/compute-impact",
      "schedule": "0 4 * * *"
    }
  ]
}
